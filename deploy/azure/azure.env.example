# Copy to azure.env (git-ignored) and fill in. deploy.sh reads this file.

# ---- Azure placement
PREFIX=estraos              # 3-12 lowercase letters/digits; prefixes every resource name
LOCATION=centralindia        # az account list-locations -o table
RESOURCE_GROUP=estraos-rg

# ---- Database
POSTGRES_ADMIN_USER=estraos
# Leave blank to generate one and print it once at the end.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_TIER=Burstable
POSTGRES_SKU=Standard_B1ms
POSTGRES_STORAGE_GB=32
# Optional: deploy into an existing Container Apps environment (some subscriptions allow only one
# per region). Leave blank to create <PREFIX>-env in RESOURCE_GROUP.
CONTAINERAPP_ENV_NAME=
CONTAINERAPP_ENV_RG=

# ---- Application secrets. Blank values are generated and printed once at the end.
JWT_SECRET=
SERVICE_ACCOUNT_PASSWORD=
# Shared key the CRM uses to call the voice agent (the agent's ADMIN_API_TOKEN).
VOICE_AGENT_API_KEY=
DEMO_PASSWORD=
# CRM <-> knowledge service, and voice agent -> knowledge service (generated when blank).
RAG_SERVICE_TOKEN=
RAG_VOICE_TOKEN=

# ---- Knowledge service (brochure/FAQ answers): page parsing and embeddings
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# ---- CRM identity the voice agent logs in as
SERVICE_ACCOUNT_EMAIL=voice-agent@estraos.internal
SERVICE_ACCOUNT_WORKSPACE_ID=1
SERVICE_ACCOUNT_WORKSPACE_NAME="Primary workspace"
# demo seeds fictional projects/leads on first boot. Use an empty value for a clean tenant.
SPRING_PROFILES_ACTIVE=demo

# ---- Voice agent providers
# fake runs offline with no provider keys and places no calls; live needs every key below.
PROVIDER_MODE=fake
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# Gnani Vachana experiment: STT_PRIMARY=gnani / TTS_PRIMARY=gnani / LLM_PROVIDER=gnani (Sarvam stays fallback).
GNANI_API_KEY=REPLACE_WITH_GNANI_API_KEY
LLM_FALLBACK_MODEL=none
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# ---- Telephony
VOICE_LINK_BASE_URL=https://app.voicelink.co.in/api
VOICE_LINK_USERNAME=
VOICE_LINK_PASSWORD=
VOICE_LINK_DID_NUMBER=
VOICE_LINK_CLIENT_ID=
VOICE_LINK_WEBHOOK_TOKEN=

# ---- Agent behaviour
WORKSPACE_ID=ws_demo
BUILDER_NAME="XYZ Realty"
DEFAULT_OUTBOUND_LANGUAGE=mr

# Your own phones (comma-separated) the agent may call outside 09:00-21:00 IST, for testing.
TEST_PHONE_ALLOWLIST=
