# Copy to .env. Never commit real keys. Every REPLACE value is intentionally invalid.

APP_ENV=dev
# fake = offline, no provider keys, places no calls. live = real providers.
PROVIDER_MODE=fake
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- Riya
# Fallback when the CRM workspace has no builder name.
BUILDER_NAME=XYZ Realty
WORKSPACE_ID=ws_demo
# Greeting language when the lead's language is unknown.
DEFAULT_INBOUND_LANGUAGE=hi
DEFAULT_OUTBOUND_LANGUAGE=mr
LANGUAGE_SWITCH_CONFIDENCE=0.6
DISCLOSE_AI=true
DISCLOSE_RECORDING=true
# TRAI window for outbound calls, Asia/Kolkata.
CALLING_HOURS_START=09:00
CALLING_HOURS_END=21:00
# Warm transfer target. Leave blank to escalate by callback + CRM handover instead.
SALES_TRANSFER_NUMBER=
LIVE_TRANSFER_ENABLED=false

# ---- CRM (EstraOS). The agent logs in as the CRM's service account.
CRM_MODE=mock
CRM_BASE_URL=http://localhost:8080
# Same values as SERVICE_ACCOUNT_WORKSPACE_ID / SERVICE_ACCOUNT_EMAIL / SERVICE_ACCOUNT_PASSWORD on the CRM.
CRM_WORKSPACE_ID=1
CRM_SERVICE_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
CRM_SERVICE_PASSWORD=REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD
CRM_TOKEN_REFRESH_MARGIN_S=120
CRM_CATALOG_REFRESH_S=900
# The CRM calls this agent with this bearer token: set the CRM's VOICE_AGENT_API_KEY to the same value.
ADMIN_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# ---- RAG knowledge service (POST /v1/voice/retrieve)
RAG_SERVICE_URL=http://localhost:8090
RAG_VOICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_TIMEOUT_MS=600

# ---- Telephony (VoiceLink)
VOICE_LINK_BASE_URL=https://app.voicelink.co.in/api
VOICE_LINK_USERNAME=
VOICE_LINK_PASSWORD=
VOICE_LINK_DID_NUMBER=
VOICE_LINK_CLIENT_ID=
VOICE_LINK_WEBHOOK_URL=
VOICE_LINK_WEBHOOK_TOKEN=
# Public base of this service, e.g. wss://agent.example.com
PUBLIC_WS_BASE_URL=

# ---- Speech and language providers
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# Gnani Vachana experiment: STT_PRIMARY=gnani / TTS_PRIMARY=gnani / LLM_PROVIDER=gnani (Sarvam stays fallback).
GNANI_API_KEY=REPLACE_WITH_GNANI_API_KEY
GNANI_TTS_VOICE_HI=Nalini
LLM_PROVIDER=sarvam
GNANI_LLM_BASE_URL=
GNANI_LLM_MODEL=

# TTS: sarvam_streaming (Bulbul) or gnani
TTS_PRIMARY=sarvam_streaming
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_PACE=1.0
# Linear gain on outgoing telephony audio. Measure before raising: mu-law clips above ~1.8x
# for a source peaking near -6 dBFS, and clipping is heard as unclear words.
TTS_OUTPUT_GAIN=1.0

SARVAM_STT_STREAMING_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
STT_FLUSH_AFTER_MS=150

LLM_PRIMARY_MODEL=sarvam-105b-conversations
LLM_PRIMARY_REASONING_EFFORT=none
LLM_FALLBACK_MODEL=none
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# ---- Storage
# Durable: call registry, do-not-call cache, outbox, and pre-rendered phrase audio.
RUNTIME_DIR=data/runtime
# WAL (local disk) or DELETE (when RUNTIME_DIR is a network share such as Azure Files).
SQLITE_JOURNAL_MODE=WAL
# Scratch: per-call debug audio. Keep off network storage.
CACHE_DIR=data/runtime
VOICE_LINK_DEBUG_AUDIO=false

# Your own phones (comma-separated) that may be called outside calling hours, for testing.
TEST_PHONE_ALLOWLIST=

# Per-call cost log (telephony excluded). Defaults are Sarvam's published prices in INR:
# Saaras v3 STT per hour of audio, Bulbul v3 TTS per 1,000 characters, Sarvam 105B per 1M tokens.
COST_STT_PER_HOUR=30
COST_TTS_PER_1K_CHARS=3
COST_LLM_INPUT_PER_M=29.28
COST_LLM_CACHED_PER_M=10.98
COST_LLM_OUTPUT_PER_M=73.20
COST_CURRENCY=INR
